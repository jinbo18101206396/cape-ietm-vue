<template>
  <a-modal
    :visible="visible"
    title="编辑属性"
    :width="1000"
    :maskClosable="false"
    :confirmLoading="saveLoading || loading"
    :bodyStyle="{ maxHeight: '70vh', overflowY: 'auto', padding: '20px 24px' }"
    okText="保存"
    cancelText="返回"
    @ok="handleSave"
    @cancel="handleClose"
  >
    <!-- 编辑说明 -->
    <a-alert
      message="编辑说明：可修改技术名称和信息名称，其他字段为只读展示"
      type="info"
      show-icon
      style="margin-bottom: 16px;"
    />

    <a-spin :spinning="loading" tip="正在加载数据...">
      <div v-if="loading" style="height: 400px;"></div>

    <a-form v-if="!loading" :form="form" :label-col="{ span: 6 }" :wrapper-col="{ span: 18 }">

      <!-- 数据模块代码（只读展示区） -->
      <div class="form-section">
        <div class="section-title">
          <a-icon type="code" class="section-icon" />
          数据模块代码
        </div>

        <a-row :gutter="20">
          <a-col :span="12">
            <a-form-item label="密级">
              <a-input :value="currentRecord.securityClassification || currentRecord.security || '-'" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="DM类型">
              <a-input :value="currentRecord.dmType || '-'" disabled />
            </a-form-item>
          </a-col>
        </a-row>

        <a-row :gutter="20">
          <a-col :span="24">
            <a-form-item label="DMC" :label-col="{span:3}" :wrapper-col="{span:21}">
              <a-input
                :value="currentRecord.dmcCode || '-'"
                disabled
                style="font-family:monospace;color:#1890ff;font-weight:500;"
              />
            </a-form-item>
          </a-col>
        </a-row>

        <a-row :gutter="20">
          <a-col :span="12">
            <a-form-item label="信息码">
              <a-input :value="currentRecord.infoCode || '-'" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="信息码变量">
              <a-input :value="currentRecord.infoCodeVariant || '-'" disabled />
            </a-form-item>
          </a-col>
        </a-row>

        <a-row :gutter="20">
          <a-col :span="12">
            <a-form-item label="位置码">
              <a-input :value="currentRecord.ietmLocationCode || '-'" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="学习码">
              <a-input :value="currentRecord.learnCode || '-'" disabled />
            </a-form-item>
          </a-col>
        </a-row>

        <a-row :gutter="20">
          <a-col :span="12">
            <a-form-item label="学习事件码">
              <a-input :value="currentRecord.learnEventCode || '-'" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="创作单位">
              <a-input :value="currentRecord.originator || '-'" disabled />
            </a-form-item>
          </a-col>
        </a-row>
      </div>

      <!-- 名称信息（可编辑区） -->
      <div class="form-section">
        <div class="section-title">
          <a-icon type="edit" class="section-icon" />
          名称信息
        </div>

        <a-row :gutter="20">
          <a-col :span="24">
            <a-form-item label="技术名称（中文）" :label-col="{span:3}" :wrapper-col="{span:21}">
              <a-input
                v-decorator="[
                  'techName',
                  {
                    rules: [
                      { required: true, message: '请输入技术名称（中文）', whitespace: true }
                    ]
                  }
                ]"
                placeholder="请输入技术名称（中文）"
                :maxLength="200"
              />
            </a-form-item>
          </a-col>
        </a-row>

        <a-row :gutter="20">
          <a-col :span="24">
            <a-form-item label="信息名称（中文）" :label-col="{span:3}" :wrapper-col="{span:21}">
              <a-input
                v-decorator="[
                  'infoName',
                  {
                    rules: [
                      { required: true, message: '请输入信息名称（中文）', whitespace: true }
                    ]
                  }
                ]"
                placeholder="请输入信息名称（中文）"
                :maxLength="200"
              />
            </a-form-item>
          </a-col>
        </a-row>
      </div>

      <!-- 版本信息（只读展示区） -->
      <div class="form-section">
        <div class="section-title">
          <a-icon type="profile" class="section-icon" />
          版本信息
        </div>

        <a-row :gutter="20">
          <a-col :span="12">
            <a-form-item label="发行号">
              <a-input :value="currentRecord.issueNo || '-'" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="在编号">
              <a-input :value="currentRecord.inWork || '-'" disabled />
            </a-form-item>
          </a-col>
        </a-row>

        <a-row :gutter="20">
          <a-col :span="12">
            <a-form-item label="版本类型">
              <a-input :value="getVersionTypeLabel(currentRecord.versionType)" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="版本日期">
              <a-input :value="formatDate(currentRecord.issueDate)" disabled />
            </a-form-item>
          </a-col>
        </a-row>

        <a-row :gutter="20">
          <a-col :span="12">
            <a-form-item label="签出人">
              <a-input :value="currentRecord.checkoutUser || '-'" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="签出时间">
              <a-input :value="formatDate(currentRecord.checkoutTime)" disabled />
            </a-form-item>
          </a-col>
        </a-row>
      </div>

    </a-form>
    </a-spin>
  </a-modal>
</template>
        <a-row :gutter="16">
          <a-col :span="12">
            <a-form-item label="责任单位" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input :value="currentRecord.rpc || '-'" disabled />
            </a-form-item>
          </a-col>
        </a-row>
      </fieldset>

      <!-- 标题（可编辑区，蓝色边框突出） -->
      <fieldset style="border:2px solid #1890ff;border-radius:4px;padding:12px 16px;margin-bottom:14px;background:#f0f7ff;">
        <legend style="font-weight:bold;font-size:14px;color:#1890ff;padding:0 8px;width:auto;">
          📝 标题（仅可编辑以下字段）
        </legend>
        <a-row :gutter="16">
          <a-col :span="12">
            <a-form-item label="技术名称" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input
                v-decorator="['techName', {
                  rules: [
                    { required: true, whitespace: true, message: '请输入技术名称和信息名称。' },
                    { max: 50, message: '技术名称最大50字符' }
                  ]
                }]"
                placeholder="请输入技术名称（最多50字）"
                :maxLength="50"
                allow-clear
              />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="信息名称" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input
                v-decorator="['infoName', {
                  rules: [
                    { required: true, whitespace: true, message: '请输入技术名称和信息名称。' },
                    { max: 50, message: '信息名称最大50字符' }
                  ]
                }]"
                placeholder="请输入信息名称（最多50字）"
                :maxLength="50"
                allow-clear
              />
            </a-form-item>
          </a-col>
        </a-row>
      </fieldset>

      <!-- DME（只读展示区） -->
      <fieldset style="border:1px solid #d9d9d9;border-radius:4px;padding:12px 16px;margin-bottom:14px;">
        <legend style="font-weight:bold;font-size:13px;padding:0 8px;width:auto;">DME</legend>
        <a-row :gutter="16">
          <a-col :span="12">
            <a-form-item label="生产者" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input :value="currentRecord.enterprise || '-'" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="扩展代码" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input :value="currentRecord.extraCode || '-'" disabled />
            </a-form-item>
          </a-col>
        </a-row>
      </fieldset>

      <!-- 语言（只读展示区） -->
      <fieldset style="border:1px solid #d9d9d9;border-radius:4px;padding:12px 16px;margin-bottom:14px;">
        <legend style="font-weight:bold;font-size:13px;padding:0 8px;width:auto;">语言</legend>
        <a-row :gutter="16">
          <a-col :span="12">
            <a-form-item label="语言" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input :value="currentRecord.languageIsoCode || '-'" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="国家" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input :value="currentRecord.countryIsoCode || '-'" disabled />
            </a-form-item>
          </a-col>
        </a-row>
      </fieldset>

      <!-- 版本信息（只读展示区） -->
      <fieldset style="border:1px solid #d9d9d9;border-radius:4px;padding:12px 16px;margin-bottom:14px;">
        <legend style="font-weight:bold;font-size:13px;padding:0 8px;width:auto;">版本</legend>
        <a-row :gutter="16">
          <a-col :span="12">
            <a-form-item label="版本" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input :value="(currentRecord.issueNo || '') + '-' + (currentRecord.inWork || '')" disabled />
            </a-form-item>
          </a-col>
          <a-col :span="12">
            <a-form-item label="版本日期" :label-col="{span:8}" :wrapper-col="{span:14}">
              <a-input :value="formatDate(currentRecord.issueDate)" disabled />
            </a-form-item>
          </a-col>
        </a-row>
      </fieldset>

      <!-- 状态提示（红色文字，位于表单底部，说明版本变化规则） -->
      <div
        style="color: red; font-size: 13px; line-height: 1.6; padding: 8px 12px;
               background: #fff1f0; border: 1px solid #ffa39e; border-radius: 4px;"
      >
        {{ statusNote }}
      </div>

    </a-form>
    </a-spin>
  </a-modal>
</template>

<script>
import { getAction, putAction } from '@/api/manage'

export default {
  name: 'DmEditPropModal',
  beforeCreate() {
    // Ant Design Vue v1 推荐在 beforeCreate 中创建 form 实例
    this.form = this.$form.createForm(this)
  },
  data() {
    return {
      visible: false,
      loading: false,
      saveLoading: false,
      currentRecord: {},
      oldTechName: '',
      oldInfoName: '',
      _requestId: 0  // 用于识别并丢弃过期请求的响应
    }
  },
  computed: {
    // 根据签出状态显示不同提示文字（与需求文档保持一致）
    statusNote() {
      const isCheckedOut = !!this.currentRecord.checkoutUser
      if (isCheckedOut) {
        return '【编辑签出状态DM的属性时，如修改技术名称、信息名称，则版本日期为当前日期，版本不升级。】'
      }
      return '【编辑签入状态DM的属性时，如修改技术名称、信息名称，则签出该DM并修改版本日期为当前日期，版本升级。】'
    }
  },
  methods: {
    /**
     * 打开弹窗，由父页面调用：this.$refs.editPropModal.show(record)
     * 调用后端 queryById 获取完整数据，确保展示最新字段
     */
    show(record) {
      const requestId = ++this._requestId  // 每次调用递增，作废旧请求
      this.visible = true
      this.loading = true
      this.currentRecord = {}  // 补全：清空旧数据，避免加载期间展示
      this.form.resetFields()  // 补全：清空表单
      getAction('/ietm/datamodule/queryById', { id: record.id })
        .then(res => {
          if (requestId !== this._requestId) return  // 过期响应，直接丢弃
          if (res.success) {
            this.currentRecord = res.result
            this.oldTechName = (res.result.techName || '').trim()
            this.oldInfoName = (res.result.infoName || '').trim()
            this.$nextTick(() => {
              this.form.setFieldsValue({
                techName: this.oldTechName,
                infoName: this.oldInfoName
              })
            })
          } else {
            this.$message.error('加载数据失败：' + (res.message || ''))
            this.visible = false
          }
        })
        .catch(() => {
          this.$message.error('网络异常，加载数据失败')
          this.visible = false
        })
        .finally(() => {
          this.loading = false
        })
    },
    // 关闭弹窗
    handleClose() {
      this._requestId++  // 使当前在途请求失效
      this.visible = false
      this.loading = false
      this.saveLoading = false  // 补全：清理保存状态
      this.form.resetFields()
      this.currentRecord = {}
      this.oldTechName = ''
      this.oldInfoName = ''
    },
    // 保存
    handleSave() {
      if (this.loading) return
      this.form.validateFields((err, values) => {
        if (err) return

        const techName = (values.techName || '').trim()
        const infoName = (values.infoName || '').trim()

        // 变化检测
        if (techName === this.oldTechName && infoName === this.oldInfoName) {
          this.$message.warning('技术名称和信息名称没有任何变化。')
          return
        }

        this.saveLoading = true

        // 后端 editProp 实现自行判断签出状态并处理版本升级逻辑：
        // - 已签出：更新属性，版本日期=今日，inWork不升级
        // - 未签出：自动签出 + inWork+1，版本日期=今日
        // 因此前端只需传递 techName 和 infoName 即可
        putAction(`/ietm/datamodule/editProp/${this.currentRecord.id}`, { techName, infoName })
          .then(res => {
            if (res.success) {
              this.$message.success(res.message || '修改DM属性成功')
              this.visible = false
              this.form.resetFields()
              this.$emit('ok')
            } else {
              this.$message.error(res.message || '操作失败，请重试')
            }
          })
          .catch(() => {
            this.$message.error('网络异常，操作失败，请重试')
          })
          .finally(() => {
            this.saveLoading = false
          })
      })
    },
    // 格式化日期（取前10位）
    formatDate(val) {
      if (!val) return '-'
      return String(val).substring(0, 10)
    }
  }
}
</script>
