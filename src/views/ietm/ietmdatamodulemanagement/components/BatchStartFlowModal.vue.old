<template>
  <a-modal
    title="批量启动流程"
    :width="1400"
    :visible="visible"
    :confirmLoading="confirmLoading"
    @ok="handleOk"
    @cancel="handleCancel"
    :maskClosable="false"
    wrapClassName="batch-start-flow-modal"
  >
    <a-spin :spinning="confirmLoading">
      <!-- North区：模板与配置工具栏 -->
      <div class="toolbar-section">
        <a-form-model :model="formData" :label-col="{ span: 8 }" :wrapper-col="{ span: 16 }">
          <a-row :gutter="16">
            <a-col :span="8">
              <a-form-model-item label="选择模板">
                <a-select
                  v-model="formData.templateId"
                  placeholder="请选择流程模板"
                  :loading="templateLoading"
                  :disabled="autoMatchedTemplate"
                  allowClear
                >
                  <a-select-option
                    v-for="tmpl in templateList"
                    :key="tmpl.id"
                    :value="tmpl.id"
                  >
                    {{ tmpl.tmplname }}
                  </a-select-option>
                </a-select>
              </a-form-model-item>
            </a-col>
            <a-col :span="8">
              <a-form-model-item label="是否紧急" required>
                <a-select v-model="formData.ifurgent" placeholder="请选择">
                  <a-select-option value="1">一般</a-select-option>
                  <a-select-option value="2">紧急</a-select-option>
                  <a-select-option value="3">特急</a-select-option>
                </a-select>
              </a-form-model-item>
            </a-col>
            <a-col :span="8">
              <a-form-model-item label="选中DM数量" :label-col="{ span: 10 }" :wrapper-col="{ span: 14 }">
                <a-input :value="`${selectedDmCount} 条`" disabled />
              </a-form-model-item>
            </a-col>
          </a-row>

          <!-- 阶段名称（仅分阶段流程时显示）-->
          <a-row v-if="isStageWorkflow" :gutter="16">
            <a-col :span="24">
              <a-form-model-item label="各阶段名称" :label-col="{ span: 2 }" :wrapper-col="{ span: 22 }">
                <a-textarea
                  v-model="formData.stagenames"
                  placeholder="请输入阶段名称，多个阶段用逗号分隔，如：编写阶段,审核阶段,签批阶段"
                  :rows="2"
                />
                <div class="hint-text">
                  <a-icon type="info-circle" /> 多个阶段用逗号分隔，顺序对应节点表中的阶段索引
                </div>
              </a-form-model-item>
            </a-col>
          </a-row>
        </a-form-model>

        <!-- 工具栏按钮 -->
        <div class="toolbar-buttons">
          <a-space :size="8">
            <a-button
              size="small"
              icon="check"
              :disabled="!formData.templateId || autoMatchedTemplate"
              @click="handleConfirmTemplate"
            >
              确定模板
            </a-button>
            <a-button size="small" icon="reload" @click="handleRefreshNodes">
              刷新
            </a-button>
            <a-button size="small" icon="plus" type="primary" @click="handleAddNode">
              增加节点
            </a-button>
            <a-button
              size="small"
              icon="delete"
              type="danger"
              :disabled="selectedNodeKeys.length === 0"
              @click="handleDeleteNode"
            >
              删除节点
            </a-button>
            <a-button size="small" icon="safety" @click="handleCheckFlow">
              检查流程
            </a-button>
          </a-space>
        </div>
      </div>

      <!-- Center区：流程节点明细表 -->
      <div class="node-table-section">
        <a-table
          :columns="nodeColumns"
          :data-source="nodeList"
          :row-selection="{
            selectedRowKeys: selectedNodeKeys,
            onChange: onNodeSelectionChange,
            getCheckboxProps: getNodeCheckboxProps
          }"
          :pagination="false"
          :scroll="{ x: 1200, y: 400 }"
          size="small"
          rowKey="id"
          bordered
        >
          <!-- 顺序号列 -->
          <template slot="seqno" slot-scope="text, record">
            <a-input-number
              v-model="record.seqno"
              :min="0"
              :max="9999"
              :disabled="record.seqno === 0"
              style="width: 100%"
            />
          </template>

          <!-- 节点名称列 -->
          <template slot="nodename" slot-scope="text, record">
            <a-input
              v-model="record.nodename"
              :disabled="isNodeNameNotEditable(record)"
            />
          </template>

          <!-- 节点类型列 -->
          <template slot="nodetype" slot-scope="text, record">
            <a-select
              v-model="record.nodetype"
              style="width: 100%"
              :disabled="record.seqno === 0"
            >
              <a-select-option value="0">创建/所有人必完成</a-select-option>
              <a-select-option value="1">审核</a-select-option>
              <a-select-option value="2">签批</a-select-option>
            </a-select>
          </template>

          <!-- 处理人ID列（authtype=1或2时显示下拉框）-->
          <template slot="userid" slot-scope="text, record">
            <a-select
              v-if="isAuthtypeOneOrTwo"
              v-model="record.userid"
              mode="multiple"
              style="width: 100%"
              placeholder="请选择处理人"
              :disabled="record.seqno === 0"
            >
              <a-select-option
                v-for="user in authUserList"
                :key="user.id"
                :value="user.id"
              >
                {{ user.realname }}
              </a-select-option>
            </a-select>
            <div v-else style="display: flex; gap: 4px;">
              <a-input
                v-model="record.userid"
                placeholder="用户ID，逗号分隔"
                style="flex: 1"
                :disabled="record.seqno === 0"
              />
              <a-button
                size="small"
                icon="user"
                :disabled="record.seqno === 0"
                @click="openUserSelector(record)"
              >
                选人
              </a-button>
            </div>
          </template>

          <!-- 处理人姓名列 -->
          <template slot="useridname" slot-scope="text, record">
            <span>{{ record.useridname || '-' }}</span>
          </template>

          <!-- 阶段列（仅分阶段时显示）-->
          <template slot="stagename" slot-scope="text, record">
            <a-select
              v-model="record.stagename"
              style="width: 100%"
              placeholder="选择阶段"
            >
              <a-select-option
                v-for="(stage, idx) in stageList"
                :key="idx"
                :value="String(idx)"
              >
                {{ stage }}
              </a-select-option>
            </a-select>
          </template>

          <!-- 可跳转节点列 -->
          <template slot="ifgetback" slot-scope="text, record">
            <a-select
              v-model="record.ifgetback"
              mode="multiple"
              style="width: 100%"
              placeholder="选择可跳转节点"
            >
              <a-select-option value="">不限制</a-select-option>
              <a-select-option value="-1">不可跳转</a-select-option>
              <a-select-option
                v-for="node in getJumpableNodes(record)"
                :key="node.id"
                :value="node.seqno"
              >
                {{ node.nodename }}({{ node.seqno }})
              </a-select-option>
            </a-select>
          </template>
        </a-table>
      </div>
    </a-spin>

    <!-- 用户选择器弹窗 -->
    <user-selector
      ref="userSelector"
      :visible="userSelectorVisible"
      @ok="handleUserSelectorOk"
      @cancel="userSelectorVisible = false"
    />
  </a-modal>
</template>

<script>
import { getAction, postAction } from '@/api/manage'
import UserSelector from './UserSelector.vue'

export default {
  name: 'BatchStartFlowModal',
  components: {
    UserSelector
  },
  props: {
    visible: {
      type: Boolean,
      default: false
    },
    selectedRecords: {
      type: Array,
      default: () => []
    },
    // 默认模板名称（从URL参数传入）
    defaultTemplate: {
      type: String,
      default: 'DM'
    },
    // 是否检查所有节点（1=全部检查，0=只检查下一节点）
    checkAllNode: {
      type: String,
      default: '1'
    },
    // 不可编辑的节点名称（逗号分隔）
    notEditNode: {
      type: String,
      default: ''
    },
    // 不可删除的节点名称（逗号分隔）
    notDelNode: {
      type: String,
      default: ''
    }
  },
  data() {
    return {
      confirmLoading: false,
      templateLoading: false,

      // 表单数据
      formData: {
        templateId: null,
        ifurgent: '1', // 默认"一般"
        stagenames: ''
      },

      // 模板列表
      templateList: [],
      autoMatchedTemplate: false, // 是否自动匹配了模板

      // 节点列表
      nodeList: [],
      selectedNodeKeys: [],
      currentEditingNode: null, // 当前正在编辑处理人的节点

      // 授权配置（从Session的IETM_CONFIG解析）
      authtype: null,
      authUserList: [], // authtype=1或2时的授权用户列表

      // 用户选择器
      userSelectorVisible: false,

      // 表格列定义
      nodeColumns: []
    }
  },
  computed: {
    // 选中DM数量
    selectedDmCount() {
      return this.selectedRecords.length
    },

    // 是否分阶段流程
    isStageWorkflow() {
      const selectedTemplate = this.templateList.find(t => t.id === this.formData.templateId)
      return selectedTemplate && selectedTemplate.stagenames
    },

    // 阶段列表
    stageList() {
      if (!this.formData.stagenames) return []
      return this.formData.stagenames.split(',').map(s => s.trim()).filter(s => s)
    },

    // 是否authtype为1或2
    isAuthtypeOneOrTwo() {
      return this.authtype === '1' || this.authtype === '2'
    }
  },
  watch: {
    visible(val) {
      if (val) {
        this.init()
      } else {
        this.reset()
      }
    },

    // 监听模板变化，自动填充阶段名称
    'formData.templateId'(templateId) {
      if (templateId) {
        const template = this.templateList.find(t => t.id === templateId)
        if (template && template.stagenames) {
          this.formData.stagenames = template.stagenames
        }
      }
    }
  },
  mounted() {
    this.initNodeColumns()
  },
  methods: {
    // 初始化
    async init() {
      this.confirmLoading = true
      try {
        // 获取authtype配置
        await this.loadAuthtypeConfig()

        // 加载模板列表
        await this.loadTemplateList()

        // 如果有默认模板，自动匹配并加载
        if (this.defaultTemplate) {
          await this.autoMatchTemplate()
        }
      } catch (error) {
        this.$message.error('初始化失败：' + error.message)
      } finally {
        this.confirmLoading = false
      }
    },

    // 重置表单
    reset() {
      this.formData = {
        templateId: null,
        ifurgent: '1',
        stagenames: ''
      }
      this.nodeList = []
      this.selectedNodeKeys = []
      this.autoMatchedTemplate = false
    },

    // 加载authtype配置
    async loadAuthtypeConfig() {
      // 从Session或全局配置获取IETM_CONFIG
      // 实际实现需要根据项目具体情况调整
      try {
        const ietmConfig = this.$store.state.ietmConfig || {}
        this.authtype = ietmConfig.authtype || null

        // 如果authtype为1或2，加载授权用户列表
        if (this.authtype === '1' || this.authtype === '2') {
          await this.loadAuthUsers()
        }
      } catch (error) {
        console.warn('加载authtype配置失败', error)
      }
    },

    // 加载授权用户列表
    async loadAuthUsers() {
      try {
        const projectId = this.$store.state.currentProject?.id
        if (!projectId) {
          this.$message.warning('请先选择项目')
          return
        }

        const params = this.authtype === '1'
          ? { objtype: '1', objid: projectId }
          : { objtype: '2', authprojectid: projectId }

        const res = await postAction('/ietm/csdb/ietmauth/IetmAuthController/operation/getIetmAuths', params)
        if (res.success) {
          this.authUserList = res.result || []
        }
      } catch (error) {
        console.error('加载授权用户失败', error)
      }
    },

    // 加载模板列表
    async loadTemplateList() {
      this.templateLoading = true
      try {
        const res = await getAction('/wf/wftemplate/WfTemplateController/operation/getPubOwnWfTemplates')
        if (res.success) {
          this.templateList = res.result || []
        } else {
          throw new Error(res.message || '加载模板列表失败')
        }
      } finally {
        this.templateLoading = false
      }
    },

    // 自动匹配模板
    async autoMatchTemplate() {
      const matched = this.templateList.find(t => t.tmplname === this.defaultTemplate)
      if (matched) {
        this.formData.templateId = matched.id
        this.autoMatchedTemplate = true
        // 自动加载节点
        await this.loadTemplateNodes(matched.id)
      }
    },

    // 确定模板（按钮）
    async handleConfirmTemplate() {
      if (!this.formData.templateId) {
        this.$message.warning('请先选择模板')
        return
      }

      this.confirmLoading = true
      try {
        await this.loadTemplateNodes(this.formData.templateId)
        this.$message.success('模板加载成功')
      } catch (error) {
        this.$message.error('加载模板失败：' + error.message)
      } finally {
        this.confirmLoading = false
      }
    },

    // 加载模板节点
    async loadTemplateNodes(templateId) {
      try {
        const res = await getAction('/wf/wftemplate/WfTemplateController/operation/getTemplateNodes', {
          templateId
        })

        if (res.success) {
          // 转换节点数据格式
          this.nodeList = (res.result || []).map((node, index) => ({
            id: node.id || `node_${Date.now()}_${index}`,
            seqno: node.seqno || 0,
            nodename: node.nodename || '',
            nodetype: node.nodetype || '0',
            userid: node.userid || '',
            useridname: node.useridname || '',
            stagename: node.stagename || '',
            ifgetback: node.ifgetback ? node.ifgetback.split(',') : [],
            ifexec: node.ifexec || 'N'
          }))

          // 确保有创建节点（seqno=0）
          if (!this.nodeList.some(n => n.seqno === 0)) {
            this.nodeList.unshift(this.createNode(0, true))
          }
        } else {
          throw new Error(res.message || '加载节点失败')
        }
      } catch (error) {
        console.error('loadTemplateNodes error:', error)
        throw error
      }
    },

    // 刷新节点
    handleRefreshNodes() {
      if (!this.formData.templateId) {
        this.$message.warning('请先选择模板')
        return
      }
      this.selectedNodeKeys = []
      this.loadTemplateNodes(this.formData.templateId)
    },

    // 增加节点
    handleAddNode() {
      const maxSeqno = Math.max(...this.nodeList.map(n => n.seqno), 0)
      const newNode = this.createNode(maxSeqno + 10)
      this.nodeList.push(newNode)
      this.$message.success('节点已添加')
    },

    // 创建节点对象
    createNode(seqno = 10, isCreateNode = false) {
      const currentUser = this.$store.state.user || {}
      return {
        id: `node_${Date.now()}_${Math.random()}`,
        seqno: seqno,
        nodename: isCreateNode ? '创建节点' : '',
        nodetype: isCreateNode ? '0' : '1',
        userid: isCreateNode ? currentUser.id : '',
        useridname: isCreateNode ? currentUser.realname : '',
        stagename: '',
        ifgetback: [],
        ifexec: isCreateNode ? 'Y' : 'N'
      }
    },

    // 删除节点
    handleDeleteNode() {
      if (this.selectedNodeKeys.length === 0) {
        this.$message.warning('请先选择要删除的节点')
        return
      }

      const notDelNodeNames = this.notDelNode.split(',').map(n => n.trim()).filter(n => n)
      const toDelete = this.nodeList.filter(n => this.selectedNodeKeys.includes(n.id))

      // 检查是否包含不可删除的节点
      const cantDelete = toDelete.filter(n => {
        // 创建节点（seqno=0）不可删除
        if (n.seqno === 0) return true
        // ifexec='Y'的节点不可删除
        if (n.ifexec === 'Y') return true
        // 在notDelNode列表中的节点不可删除
        if (notDelNodeNames.includes(n.nodename)) return true
        return false
      })

      if (cantDelete.length > 0) {
        this.$message.error(`以下节点不可删除：${cantDelete.map(n => n.nodename).join('、')}`)
        return
      }

      this.$confirm({
        title: '确认删除',
        content: `确定要删除选中的 ${toDelete.length} 个节点吗？`,
        onOk: () => {
          this.nodeList = this.nodeList.filter(n => !this.selectedNodeKeys.includes(n.id))
          this.selectedNodeKeys = []
          this.$message.success('删除成功')
        }
      })
    },

    // 检查流程
    handleCheckFlow() {
      const errors = this.validateNodes()
      if (errors.length === 0) {
        this.$message.success('流程配置检查通过')
      } else {
        this.$warning({
          title: '流程配置检查',
          content: (
            <div>
              <p>发现以下问题：</p>
              <ul>
                {errors.map((err, idx) => (
                  <li key={idx}>{err}</li>
                ))}
              </ul>
            </div>
          )
        })
      }
    },

    // 节点选择变化
    onNodeSelectionChange(selectedRowKeys) {
      this.selectedNodeKeys = selectedRowKeys
    },

    // 获取节点checkbox属性（禁用创建节点选择）
    getNodeCheckboxProps(record) {
      return {
        props: {
          disabled: record.seqno === 0 || record.ifexec === 'Y'
        }
      }
    },

    // 判断节点名称是否可编辑
    isNodeNameNotEditable(record) {
      if (record.seqno === 0) return true
      const notEditNodeNames = this.notEditNode.split(',').map(n => n.trim()).filter(n => n)
      return notEditNodeNames.includes(record.nodename)
    },

    // 打开用户选择器
    openUserSelector(record) {
      this.currentEditingNode = record
      this.userSelectorVisible = true
    },

    // 用户选择器确认
    handleUserSelectorOk(result) {
      if (this.currentEditingNode) {
        this.currentEditingNode.userid = result.userid
        this.currentEditingNode.useridname = result.useridname
      }
      this.userSelectorVisible = false
      this.currentEditingNode = null
    },

    // 获取可跳转的节点列表（排除自己）
    getJumpableNodes(currentNode) {
      return this.nodeList.filter(n => n.id !== currentNode.id)
    },

    // 初始化表格列
    initNodeColumns() {
      const baseColumns = [
        {
          title: '顺序号',
          dataIndex: 'seqno',
          width: 100,
          align: 'center',
          scopedSlots: { customRender: 'seqno' }
        },
        {
          title: '节点名称',
          dataIndex: 'nodename',
          width: 150,
          scopedSlots: { customRender: 'nodename' }
        },
        {
          title: '节点类型',
          dataIndex: 'nodetype',
          width: 150,
          scopedSlots: { customRender: 'nodetype' }
        }
      ]

      // 根据authtype决定显示userid还是useridname列
      if (this.isAuthtypeOneOrTwo) {
        baseColumns.push({
          title: '处理人ID',
          dataIndex: 'userid',
          width: 200,
          scopedSlots: { customRender: 'userid' }
        })
      } else {
        baseColumns.push({
          title: '处理人ID',
          dataIndex: 'userid',
          width: 200,
          scopedSlots: { customRender: 'userid' }
        })
        baseColumns.push({
          title: '处理人姓名',
          dataIndex: 'useridname',
          width: 200,
          scopedSlots: { customRender: 'useridname' }
        })
      }

      // 如果是分阶段流程，添加阶段列
      if (this.isStageWorkflow) {
        baseColumns.push({
          title: '阶段',
          dataIndex: 'stagename',
          width: 120,
          scopedSlots: { customRender: 'stagename' }
        })
      }

      baseColumns.push({
        title: '可跳转节点',
        dataIndex: 'ifgetback',
        width: 200,
        scopedSlots: { customRender: 'ifgetback' }
      })

      this.nodeColumns = baseColumns
    },

    // 校验节点配置
    validateNodes() {
      const errors = []

      if (this.nodeList.length === 0) {
        errors.push('节点列表不能为空')
        return errors
      }

      // 检查必须有创建节点
      const hasCreateNode = this.nodeList.some(n => n.seqno === 0 && n.nodetype === '0')
      if (!hasCreateNode) {
        errors.push('必须包含创建节点（节点类型=创建/所有人必完成，顺序号=0）')
      }

      // 检查每个节点
      this.nodeList.forEach((node, index) => {
        const rowNum = index + 1

        // 检查节点名称
        if (!node.nodename || !node.nodename.trim()) {
          errors.push(`第${rowNum}行：节点名称不能为空`)
        }

        // 检查顺序号
        if (node.seqno === null || node.seqno === undefined) {
          errors.push(`第${rowNum}行：顺序号不能为空`)
        } else if (node.seqno < 0 || node.seqno > 9999) {
          errors.push(`第${rowNum}行：顺序号必须在0-9999之间`)
        }

        // 检查处理人（创建节点除外）
        if (node.seqno !== 0 && (!node.userid || !node.userid.trim())) {
          errors.push(`第${rowNum}行：处理人不能为空`)
        }

        // 检查顺序号唯一性
        const duplicateSeqno = this.nodeList.filter(n => n.seqno === node.seqno)
        if (duplicateSeqno.length > 1) {
          errors.push(`第${rowNum}行：顺序号${node.seqno}重复`)
        }
      })

      // 如果checkAllNode=1，进行全量检查
      if (this.checkAllNode === '1') {
        // 可以添加更多检查规则
      }

      return errors
    },

    // 确定提交
    async handleOk() {
      // 1. 校验表单
      if (!this.formData.templateId) {
        this.$message.warning('请选择流程模板')
        return
      }

      if (!this.formData.ifurgent) {
        this.$message.warning('请选择紧急级别')
        return
      }

      // 2. 校验节点
      const errors = this.validateNodes()
      if (errors.length > 0) {
        this.$warning({
          title: '数据校验失败',
          content: (
            <div>
              <ul>
                {errors.map((err, idx) => (
                  <li key={idx}>{err}</li>
                ))}
              </ul>
            </div>
          )
        })
        return
      }

      // 3. 组装数据并提交
      this.confirmLoading = true
      try {
        await this.submitBatchStartFlow()
        this.$message.success('批量启动流程成功')
        this.$emit('ok')
        this.handleCancel()
      } catch (error) {
        this.$message.error('批量启动流程失败：' + error.message)
      } finally {
        this.confirmLoading = false
      }
    },

    // 提交批量启动流程
    async submitBatchStartFlow() {
      // 组装instDatas
      const formids = this.selectedRecords.map(r => r.id).join(',')
      const insttitleparam = this.selectedRecords.map(r => `【${r.dmc}】`).join(',')

      const instDatas = {
        title: '',
        titleparam: insttitleparam,
        url: 'avicit/ietm/csdb/ietmdm/IetmDmDetail.jsp',
        ifurgent: this.formData.ifurgent,
        stagenames: this.formData.stagenames || ''
      }

      // 组装instdtlDatas（节点配置）
      const instdtlDatas = this.nodeList.map(node => ({
        seqno: node.seqno,
        nodename: node.nodename,
        nodetype: node.nodetype,
        userid: Array.isArray(node.userid) ? node.userid.join(',') : node.userid,
        useridname: node.useridname,
        stagename: node.stagename,
        ifgetback: Array.isArray(node.ifgetback) ? node.ifgetback.join(',') : node.ifgetback,
        ifexec: node.ifexec
      }))

      // 提交到后端
      const res = await postAction('/ietm/workflow/batchStartFlow', {
        instDatas: JSON.stringify(instDatas),
        instdtlDatas: JSON.stringify(instdtlDatas),
        formids: formids
      })

      if (!res.success) {
        throw new Error(res.message || '提交失败')
      }
    },

    // 取消
    handleCancel() {
      this.$emit('cancel')
    }
  }
}
</script>

<style scoped>
.batch-start-flow-modal .toolbar-section {
  padding: 16px;
  background: #fafafa;
  border: 1px solid #e8e8e8;
  border-radius: 4px;
  margin-bottom: 16px;
}

.batch-start-flow-modal .toolbar-buttons {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #e8e8e8;
}

.batch-start-flow-modal .hint-text {
  font-size: 12px;
  color: #8c8c8c;
  margin-top: 4px;
}

.batch-start-flow-modal .node-table-section {
  margin-top: 16px;
}
</style>
