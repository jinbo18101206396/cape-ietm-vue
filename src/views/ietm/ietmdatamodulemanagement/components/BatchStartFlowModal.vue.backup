<template>
  <a-modal
    title="批量启动流程"
    :width="1200"
    :visible="visible"
    :confirmLoading="confirmLoading"
    @ok="handleOk"
    @cancel="handleCancel"
    :maskClosable="false"
    :bodyStyle="{ maxHeight: '75vh', overflowY: 'auto', padding: '16px 24px' }"
  >
    <a-spin :spinning="confirmLoading">
      <!-- North区：模板与配置工具栏 -->
      <div class="toolbar-section" style="margin-bottom: 16px; padding: 16px; background: #fafafa; border-radius: 4px;">
        <a-row :gutter="16">
          <a-col :span="8">
            <a-form-model-item label="选择模板" :label-col="{ span: 8 }" :wrapper-col="{ span: 16 }">
              <a-select
                v-model="model.templateId"
                placeholder="请选择流程模板"
                :loading="templateLoading"
                @change="handleTemplateChange"
                allowClear
              >
                <a-select-option v-for="tmpl in templateList" :key="tmpl.id" :value="tmpl.id">
                  {{ tmpl.tmplname }}
                </a-select-option>
              </a-select>
            </a-form-model-item>
          </a-col>
          <a-col :span="8">
            <a-form-model-item label="紧急级别" :label-col="{ span: 8 }" :wrapper-col="{ span: 16 }" required>
              <a-select v-model="model.ifurgent" placeholder="请选择">
                <a-select-option value="1">一般</a-select-option>
                <a-select-option value="2">紧急</a-select-option>
                <a-select-option value="3">特急</a-select-option>
              </a-select>
            </a-form-model-item>
          </a-col>
          <a-col :span="8">
            <a-form-model-item label="选中DM数量" :label-col="{ span: 10 }" :wrapper-col="{ span: 14 }">
              <a-input :value="`${selectedDmCount} 条`" disabled />
            </a-form-model-item>
          </a-col>
        </a-row>

        <!-- 阶段名称（分阶段流程时显示）-->
        <a-row v-if="isStageWorkflow" :gutter="16" style="margin-top: 8px;">
          <a-col :span="24">
            <a-form-model-item label="各阶段名称" :label-col="{ span: 3 }" :wrapper-col="{ span: 21 }">
              <a-textarea
                v-model="model.stagenames"
                placeholder="请输入阶段名称，多个阶段用逗号分隔，如：编写阶段,审核阶段,签批阶段"
                :rows="2"
              />
              <div style="font-size: 12px; color: #8c8c8c; margin-top: 4px;">
                <a-icon type="info-circle" /> 多个阶段用逗号分隔，顺序对应节点表中的阶段索引
              </div>
            </a-form-model-item>
          </a-col>
        </a-row>

        <!-- 工具栏按钮 -->
        <a-row :gutter="8" style="margin-top: 8px;">
          <a-col :span="24" style="text-align: left;">
            <a-space :size="8">
              <a-button
                size="small"
                icon="check"
                :disabled="!model.templateId"
                @click="handleConfirmTemplate"
              >
                确定模板
              </a-button>
              <a-button size="small" icon="reload" @click="handleRefreshNodes">
                刷新节点
              </a-button>
              <a-button size="small" icon="plus" type="primary" @click="handleAddNode">
                增加节点
              </a-button>
              <a-button
                size="small"
                icon="delete"
                type="danger"
                :disabled="selectedNodeKeys.length === 0"
                @click="handleDeleteSelectedNodes"
              >
                删除节点
              </a-button>
              <a-button size="small" icon="check-circle" @click="handleCheckNodes">
                检查流程
              </a-button>
            </a-space>
          </a-col>
        </a-row>
      </div>

      <!-- Center区：流程节点明细表 -->
      <div class="form-section">
        <div class="section-title">
          <a-icon type="apartment" class="section-icon" />
          流程节点配置
        </div>

        <a-table
          :columns="nodeColumns"
          :data-source="model.nodes"
          :pagination="false"
          :row-selection="{
            selectedRowKeys: selectedNodeKeys,
            onChange: onNodeSelectionChange,
            getCheckboxProps: record => ({
              props: {
                disabled: record.seqno === 0 || record.ifexec === 'Y'
              }
            })
          }"
          bordered
          size="small"
          rowKey="seqno"
        >
          <!-- 顺序号 -->
          <template slot="seqno" slot-scope="text, record">
            <a-input-number
              v-model="record.seqno"
              :min="record.seqno === 0 ? 0 : 1"
              :max="9999"
              :disabled="record.seqno === 0"
              style="width: 100%"
            />
          </template>

          <!-- 节点名称 -->
          <template slot="nodename" slot-scope="text, record">
            <a-input
              v-model="record.nodename"
              placeholder="请输入节点名称"
              :disabled="record.seqno === 0 && noteditNode"
            />
          </template>

          <!-- 节点类型 -->
          <template slot="nodetype" slot-scope="text, record">
            <a-select
              v-model="record.nodetype"
              placeholder="请选择"
              style="width: 100%"
              :disabled="record.seqno === 0"
            >
              <a-select-option value="0">创建节点/所有人必完成</a-select-option>
              <a-select-option value="1">审核节点</a-select-option>
              <a-select-option value="2">签批节点</a-select-option>
              <a-select-option value="3">会签节点</a-select-option>
              <a-select-option value="4">并行节点</a-select-option>
            </a-select>
          </template>

          <!-- 处理人ID（authtype=1/2时显示）-->
          <template v-if="showUseridColumn" slot="userid" slot-scope="text, record">
            <a-select
              v-model="record.userid"
              mode="multiple"
              placeholder="请选择处理人"
              style="width: 100%"
              :disabled="record.seqno === 0"
            >
              <a-select-option v-for="user in authorizedUsers" :key="user.id" :value="user.id">
                {{ user.name }}
              </a-select-option>
            </a-select>
          </template>

          <!-- 处理人姓名（authtype非1/2时显示）-->
          <template v-if="!showUseridColumn" slot="useridname" slot-scope="text, record">
            <a-input
              v-model="record.useridname"
              placeholder="点击选择"
              :disabled="record.seqno === 0"
              @click="() => handleSelectUser(record)"
              readonly
              style="cursor: pointer;"
            >
              <a-icon slot="suffix" type="team" style="color: #1890ff;" />
            </a-input>
            <div v-if="record.userid" style="font-size: 11px; color: #8c8c8c; margin-top: 2px;">
              ID: {{ record.userid }}
            </div>
          </template>

          <!-- 阶段（分阶段流程时显示）-->
          <template v-if="isStageWorkflow" slot="stagename" slot-scope="text, record">
            <a-select v-model="record.stagename" placeholder="请选择阶段" style="width: 100%">
              <a-select-option v-for="(stage, idx) in stageOptions" :key="idx" :value="String(idx)">
                {{ stage }}
              </a-select-option>
            </a-select>
          </template>

          <!-- 可跳转节点 -->
          <template slot="ifgetback" slot-scope="text, record">
            <a-select
              v-model="record.ifgetback"
              mode="multiple"
              placeholder="《不限制》"
              style="width: 100%"
              allowClear
            >
              <a-select-option value="-1">《不可跳转》</a-select-option>
              <a-select-option
                v-for="node in model.nodes"
                :key="node.seqno"
                :value="String(node.seqno)"
                :disabled="node.seqno === record.seqno"
              >
                {{ node.nodename || `节点${node.seqno}` }}
              </a-select-option>
            </a-select>
          </template>

          <!-- 操作 -->
          <template slot="action" slot-scope="text, record, index">
            <a
              @click="handleDeleteNode(index)"
              :disabled="record.seqno === 0 || record.ifexec === 'Y' || notdelNode"
              :style="{ color: (record.seqno === 0 || notdelNode) ? '#ccc' : '#ff4d4f', cursor: (record.seqno === 0 || notdelNode) ? 'not-allowed' : 'pointer' }"
            >
              <a-icon type="delete" /> 删除
            </a>
          </template>
        </a-table>
      </div>
    </a-spin>

    <!-- 用户选择器弹窗 -->
    <user-selector-modal
      ref="userSelector"
      @ok="handleUserSelected"
    />
  </a-modal>
</template>

<script>
import { getAction, postAction } from '@/api/manage'
import { generateUUID } from '@/utils/util'
import UserSelectorModal from './UserSelectorModal.vue'

export default {
  name: 'BatchStartFlowModal',
  components: {
    UserSelectorModal
  },
  data() {
    return {
      visible: false,
      confirmLoading: false,
      templateLoading: false,
      selectedDmIds: [],
      selectedNodeKeys: [], // 节点表格选中的行
      currentSelectingNode: null, // 当前正在选择处理人的节点
      templateList: [], // 流程模板列表
      authorizedUsers: [], // 授权用户列表（authtype=1/2时使用）
      noteditNode: false, // 是否禁止编辑节点名称
      notdelNode: false, // 是否禁止删除节点
      authtype: '0', // 权限类型（从系统配置读取）
      model: {
        batchId: '',
        dmIds: [],
        templateId: '',
        ifurgent: '1',
        stagenames: '',
        nodes: []
      }
    }
  },
  computed: {
    selectedDmCount() {
      return this.selectedDmIds.length
    },
    // 是否是分阶段流程
    isStageWorkflow() {
      if (!this.model.templateId) return false
      const template = this.templateList.find(t => t.id === this.model.templateId)
      return template && template.stagenames && template.stagenames.trim() !== ''
    },
    // 阶段选项（从stagenames解析）
    stageOptions() {
      if (!this.model.stagenames) return []
      return this.model.stagenames.split(',').map(s => s.trim()).filter(s => s)
    },
    // 是否显示userid列（authtype=1/2时显示）
    showUseridColumn() {
      return this.authtype === '1' || this.authtype === '2'
    },
    // 动态计算表格列
    nodeColumns() {
      const baseColumns = [
        {
          title: '顺序号',
          dataIndex: 'seqno',
          width: 80,
          align: 'center',
          scopedSlots: { customRender: 'seqno' }
        },
        {
          title: '节点名称',
          dataIndex: 'nodename',
          width: 150,
          scopedSlots: { customRender: 'nodename' }
        },
        {
          title: '节点类型',
          dataIndex: 'nodetype',
          width: 180,
          scopedSlots: { customRender: 'nodetype' }
        }
      ]

      // 根据authtype决定显示哪个处理人列
      if (this.showUseridColumn) {
        baseColumns.push({
          title: '处理人ID',
          dataIndex: 'userid',
          width: 200,
          scopedSlots: { customRender: 'userid' }
        })
      } else {
        baseColumns.push({
          title: '处理人姓名',
          dataIndex: 'useridname',
          width: 200,
          scopedSlots: { customRender: 'useridname' }
        })
      }

      // 分阶段流程时显示阶段列
      if (this.isStageWorkflow) {
        baseColumns.push({
          title: '阶段',
          dataIndex: 'stagename',
          width: 120,
          scopedSlots: { customRender: 'stagename' }
        })
      }

      // 可跳转节点列
      baseColumns.push({
        title: '可跳转节点',
        dataIndex: 'ifgetback',
        width: 150,
        scopedSlots: { customRender: 'ifgetback' }
      })

      // 操作列
      baseColumns.push({
        title: '操作',
        dataIndex: 'action',
        width: 80,
        align: 'center',
        fixed: 'right',
        scopedSlots: { customRender: 'action' }
      })

      return baseColumns
    }
  },
  methods: {
    // 打开弹窗
    show(selectedRecords) {
      this.visible = true
      this.selectedDmIds = selectedRecords.map(r => r.id)
      this.model.dmIds = [...this.selectedDmIds]
      this.model.batchId = generateUUID()
      this.selectedNodeKeys = []

      // 重置节点配置（初始化创建节点）
      this.resetNodes()

      // 加载流程模板列表
      this.loadTemplateList()

      // 读取系统配置中的authtype
      this.loadAuthtype()

      // 如果authtype=1/2，加载授权用户列表
      if (this.showUseridColumn) {
        this.loadAuthorizedUsers()
      }
    },

    // 重置节点配置
    resetNodes() {
      const currentUser = this.$store.getters.userInfo
      this.model.nodes = [
        {
          seqno: 0,
          nodename: '创建节点',
          nodetype: '0',
          userid: currentUser?.id || '',
          useridname: currentUser?.realname || '',
          stagename: this.isStageWorkflow ? '0' : '',
          ifgetback: '',
          ifexec: 'Y' // 标记为已执行，不可删除
        }
      ]
    },

    // 加载流程模板列表
    loadTemplateList() {
      this.templateLoading = true
      getAction('/wf/wftemplate/getPubOwnWfTemplates')
        .then(res => {
          if (res.success) {
            this.templateList = res.result || []
          } else {
            this.$message.warning('加载流程模板失败：' + (res.message || ''))
          }
        })
        .catch(err => {
          console.error('加载流程模板失败', err)
          this.$message.error('加载流程模板失败')
        })
        .finally(() => {
          this.templateLoading = false
        })
    },

    // 读取authtype配置
    loadAuthtype() {
      // 从localStorage或Vuex读取IETM_CONFIG
      const ietmConfig = localStorage.getItem('IETM_CONFIG')
      if (ietmConfig) {
        try {
          const config = JSON.parse(ietmConfig)
          this.authtype = config.authtype || '0'
        } catch (e) {
          console.error('解析IETM_CONFIG失败', e)
          this.authtype = '0'
        }
      }
    },

    // 加载授权用户列表（authtype=1/2时）
    loadAuthorizedUsers() {
      const projectId = this.$store.getters.currentProject?.id
      if (!projectId) {
        this.$message.warning('未选择项目')
        return
      }

      const params = {
        objtype: this.authtype === '1' ? '1' : '2', // 1=按项目，2=按角色
        objid: projectId,
        authprojectid: projectId
      }

      postAction('/ietm/ietmauth/getIetmAuths', params)
        .then(res => {
          if (res.success) {
            this.authorizedUsers = (res.result || []).map(item => ({
              id: item.userid || item.id,
              name: item.username || item.name
            }))
          }
        })
        .catch(err => {
          console.error('加载授权用户失败', err)
        })
    },

    // 模板变化事件
    handleTemplateChange(templateId) {
      if (!templateId) {
        this.model.stagenames = ''
        return
      }

      const template = this.templateList.find(t => t.id === templateId)
      if (template) {
        // 自动填充阶段名称
        this.model.stagenames = template.stagenames || ''
      }
    },

    // 确定模板（加载模板节点配置）
    handleConfirmTemplate() {
      if (!this.model.templateId) {
        this.$message.warning('请先选择流程模板')
        return
      }

      this.confirmLoading = true
      getAction(`/wf/wftemplate/getTemplateDtl/${this.model.templateId}`)
        .then(res => {
          if (res.success && res.result && res.result.length > 0) {
            // 保留创建节点，加载其他节点
            const createNode = this.model.nodes.find(n => n.seqno === 0)
            const templateNodes = res.result.map(node => ({
              seqno: node.seqno,
              nodename: node.nodename,
              nodetype: node.nodetype,
              userid: '',
              useridname: '',
              stagename: node.stagename || '',
              ifgetback: node.ifgetback || ''
            }))

            this.model.nodes = [createNode, ...templateNodes.filter(n => n.seqno !== 0)]
            this.$message.success('模板节点加载成功')
          } else {
            this.$message.warning('模板无节点配置')
          }
        })
        .catch(err => {
          console.error('加载模板节点失败', err)
          this.$message.error('加载模板节点失败')
        })
        .finally(() => {
          this.confirmLoading = false
        })
    },

    // 刷新节点
    handleRefreshNodes() {
      this.resetNodes()
      this.selectedNodeKeys = []
      this.$message.info('已重置节点配置')
    },

    // 添加节点
    handleAddNode() {
      const maxSeqno = Math.max(...this.model.nodes.map(n => n.seqno), 0)
      const newSeqno = maxSeqno + 10

      this.model.nodes.push({
        seqno: newSeqno,
        nodename: '',
        nodetype: '1',
        userid: '',
        useridname: '',
        stagename: this.isStageWorkflow ? '0' : '',
        ifgetback: ''
      })

      this.$message.success('已添加新节点')
    },

    // 删除选中的节点
    handleDeleteSelectedNodes() {
      if (this.selectedNodeKeys.length === 0) {
        this.$message.warning('请选择要删除的节点')
        return
      }

      this.model.nodes = this.model.nodes.filter(
        node => !this.selectedNodeKeys.includes(node.seqno) || node.seqno === 0 || node.ifexec === 'Y'
      )
      this.selectedNodeKeys = []
      this.$message.success('已删除选中节点')
    },

    // 删除单个节点
    handleDeleteNode(index) {
      const node = this.model.nodes[index]
      if (node.seqno === 0 || node.ifexec === 'Y' || this.notdelNode) {
        this.$message.warning('该节点不允许删除')
        return
      }

      this.model.nodes.splice(index, 1)
      this.$message.success('节点已删除')
    },

    // 节点表格选择变化
    onNodeSelectionChange(selectedRowKeys) {
      this.selectedNodeKeys = selectedRowKeys
    },

    // 检查流程配置
    handleCheckNodes() {
      const errors = this.validateForm()
      if (errors.length > 0) {
        this.$message.error('校验失败：' + errors[0])
      } else {
        this.$message.success('流程配置校验通过')
      }
    },

    // 打开用户选择器
    handleSelectUser(record) {
      this.currentSelectingNode = record
      this.$refs.userSelector.show()
    },

    // 用户选择完成
    handleUserSelected(selectedUsers) {
      if (!this.currentSelectingNode) return

      // selectedUsers结构: [{ id, name, type, prefix }]
      const userids = selectedUsers.map(u => u.prefix ? `${u.prefix}${u.id}` : u.id).join(',')
      const usernames = selectedUsers.map(u => {
        if (u.type === 'dept') return `[${u.name}]`
        if (u.type === 'role') return `{${u.name}}`
        if (u.type === 'group') return `‹${u.name}›`
        if (u.type === 'position') return `(${u.name})`
        return u.name
      }).join(',')

      this.currentSelectingNode.userid = userids
      this.currentSelectingNode.useridname = usernames
      this.currentSelectingNode = null
    },

    // 提交
    handleOk() {
      // 前端表单验证
      const errors = this.validateForm()
      if (errors.length > 0) {
        this.$message.warning(errors[0])
        return
      }

      this.confirmLoading = true

      const params = {
        batchId: this.model.batchId,
        dmIds: this.model.dmIds,
        nodes: this.model.nodes.map(node => ({
          seqno: node.seqno,
          nodename: node.nodename,
          nodetype: node.nodetype,
          userid: node.userid,
          useridname: node.useridname,
          stagename: node.stagename || '',
          ifgetback: Array.isArray(node.ifgetback) ? node.ifgetback.join(',') : (node.ifgetback || '')
        })),
        ifurgent: this.model.ifurgent,
        stagenames: this.model.stagenames,
        templateId: this.model.templateId || ''
      }

      postAction('/ietm/workflow/batchStartFlow', params)
        .then(res => {
          if (res.success) {
            this.$message.success(res.message || '批量启动成功')
            this.handleCancel()
            this.$emit('ok')
          } else {
            this.$message.error(res.message || '批量启动失败')
          }
        })
        .catch(err => {
          console.error('批量启动流程失败', err)
          if (err.response) {
            const status = err.response.status
            if (status === 400) {
              this.$message.error('请求参数错误：' + (err.response.data.message || ''))
            } else if (status === 401) {
              this.$message.error('未登录或登录已过期，请重新登录')
            } else if (status === 500) {
              this.$message.error('服务器错误：' + (err.response.data.message || ''))
            } else {
              this.$message.error('操作失败：' + (err.message || '未知错误'))
            }
          } else if (err.request) {
            this.$message.error('网络错误，请检查网络连接')
          } else {
            this.$message.error('操作失败：' + (err.message || '未知错误'))
          }
        })
        .finally(() => {
          this.confirmLoading = false
        })
    },

    // 关闭弹窗
    handleCancel() {
      this.visible = false
      this.model.templateId = ''
      this.model.stagenames = ''
      this.resetNodes()
      this.selectedNodeKeys = []
    },

    // 前端表单验证
    validateForm() {
      const errors = []

      // 验证紧急级别
      if (!this.model.ifurgent) {
        errors.push('请选择紧急级别')
        return errors
      }

      // 验证节点配置
      if (this.model.nodes.length === 0) {
        errors.push('请至少配置一个节点')
        return errors
      }

      // 验证创建节点存在
      let hasCreateNode = false
      const seqnoSet = new Set()

      for (const node of this.model.nodes) {
        // 检查创建节点
        if (node.nodetype === '0' && node.seqno === 0) {
          hasCreateNode = true
        }

        // 检查seqno重复
        if (seqnoSet.has(node.seqno)) {
          errors.push(`节点顺序号重复：${node.seqno}`)
          return errors
        }
        seqnoSet.add(node.seqno)

        // 检查必填字段
        if (!node.nodename || node.nodename.trim() === '') {
          errors.push(`节点${node.seqno}：节点名称不能为空`)
          return errors
        }

        if (!node.nodetype) {
          errors.push(`节点${node.seqno}：节点类型不能为空`)
          return errors
        }

        if (!node.userid || node.userid.trim() === '') {
          errors.push(`节点${node.seqno}：处理人ID不能为空`)
          return errors
        }

        if (!node.useridname || node.useridname.trim() === '') {
          errors.push(`节点${node.seqno}：处理人姓名不能为空`)
          return errors
        }

        // 校验userid和useridname数量一致
        const userids = node.userid.split(',').filter(id => id.trim())
        const usernames = node.useridname.split(',').filter(name => name.trim())
        if (userids.length !== usernames.length) {
          errors.push(`节点${node.seqno}：处理人ID数量（${userids.length}）与姓名数量（${usernames.length}）不一致`)
          return errors
        }
      }

      if (!hasCreateNode) {
        errors.push('必须包含创建节点（节点类型=创建节点，顺序号=0）')
        return errors
      }

      return errors
    }
  }
}
</script>

